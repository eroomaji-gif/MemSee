-- ทำงานแบบ Real-time บังคับทิศทางตัวละครและมุมมองข้ามการควบคุมของนิ้ว
RunService.RenderStepped:Connect(function()
    if HardLockEnabled then
        pcall(function()
            local target = getAbsoluteClosestPlayer()
            if target and target.Character then
                local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                local myChar = localPlayer.Character
                
                if targetRoot and myChar then
                    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        -- 1. บังคับล็อกทิศทางตัวละคร (HumanoidRootPart) ให้หันหน้าเข้าหาเป้าหมายตลอดเวลา
                        -- ทำให้เวลาปล่อยสกิล ทิศทางของสกิลจะพุ่งตรงไปหาคนนั้นทันทีโดยไม่สนว่านิ้วเราจะหันไปทางไหน
                        myRoot.CFrame = CFrame.new(myRoot.Position, Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z))
                        
                        -- 2. บังคับล็อกกล้องให้มองตรงไปที่เป้าหมายด้วย
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetRoot.Position)
                    end
                end
            end
        end)
    end
end)

