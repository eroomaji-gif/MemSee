-- ฟังก์ชันกวาดหาผู้เล่นทุกคนในเซิร์ฟเวอร์ และเลือกคนใกล้ที่สุด
local function getAbsoluteClosestPlayer()
    local targetPlayer = nil
    local minDistance = math.huge

    local myChar = localPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    -- กวาดหารายชื่อผู้เล่นทุกคนในเซิร์ฟเวอร์แบบครบถ้วน
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local enemyChar = player.Character
            local enemyHumanoid = enemyChar:FindFirstChildOfClass("Humanoid")
            local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
            
            -- เช็คว่าเป้าหมายมีชีวิตอยู่ และมีเลือดมากกว่า 0
            if enemyHumanoid and enemyHumanoid.Health > 0 and enemyRoot then
                local distance = (enemyRoot.Position - myRoot.Position).Magnitude
                if distance < minDistance then
                    minDistance = distance
                    targetPlayer = player
                end
            end
        end
    end

    return targetPlayer
end

