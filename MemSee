-- ==========================================
-- สร้างปุ่มเมนูด้านซ้าย และระบบสลับหน้าจอ
-- ==========================================
local categoryNames = {"หน้าแรก", "หาของ", "ทะเล", "ลงดัน", "PVP", "ข้อมูล"}
local sidebarButtons = {}

for i, catName in ipairs(categoryNames) do
    local btn = Instance.new("TextButton")
    btn.Name = catName .. "Btn"
    btn.Parent = SidebarFrame
    -- ให้ปุ่ม "หน้าแรก" มีสีเด่นกว่าตอนเริ่มต้น
    btn.BackgroundColor3 = (catName == "หน้าแรก") and Color3.fromRGB(60, 120, 200) or Color3.fromRGB(45, 45, 45)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = catName
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.LayoutOrder = i

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    sidebarButtons[catName] = btn

    -- ระบบกดเปลี่ยนหน้า
    btn.MouseButton1Click:Connect(function()
        -- ซ่อนทุกหน้า และปรับสีปุ่มซ้ายทั้งหมดให้เป็นปกติ
        for name, p in pairs(pages) do
            p.Visible = false
            sidebarButtons[name].BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        end
        -- แสดงเฉพาะหน้าที่เลือก และเปลี่ยนสีปุ่มให้เด่นขึ้น
        pages[catName].Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(60, 120, 200)
    end)
end

