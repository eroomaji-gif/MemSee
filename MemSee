-- ลูปทำงานกวาดหาและสร้าง Highlight แสดงตัวเป้าหมาย
RunService.RenderStepped:Connect(function()
    if TargetLockEnabled then
        pcall(function()
            local target = getClosestTarget()
            if target and target.Character then
                -- เช็คว่าเป้าหมายมี Highlight หรือยัง ถ้ายังให้สร้างอันใหม่ครอบไว้
                if not currentHighlight or currentHighlight.Parent ~= target.Character then
                    if currentHighlight then currentHighlight:Destroy() end
                    
                    currentHighlight = Instance.new("Highlight")
                    currentHighlight.Name = "KTO_TargetHighlight"
                    currentHighlight.Adornee = target.Character
                    currentHighlight.FillColor = Color3.fromRGB(255, 0, 0) -- สีแดงเด่นชัด
                    currentHighlight.FillTransparency = 0.5
                    currentHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    currentHighlight.OutlineTransparency = 0
                    currentHighlight.Parent = target.Character
                end
            else
                if currentHighlight then
                    currentHighlight:Destroy()
                    currentHighlight = nil
                end
            end
        end)
    else
        if currentHighlight then
            currentHighlight:Destroy()
            currentHighlight = nil
        end
    end
end)

