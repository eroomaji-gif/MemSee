local function createCategoryButton(name, order)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Btn"
    btn.Parent = SidebarFrame
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.LayoutOrder = order
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    return btn
end

-- ฟังก์ชันสร้างปุ่มกดเปิด/ปิดฟังก์ชันในฝั่งขวา
local function createFeatureToggle(name, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Toggle"
    btn.Parent = ContentContainer
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Size = UDim2.new(1, -10, 0, 40)
    btn.Font = Enum.Font.Gotham
    btn.Text = "  [ OFF ] " .. name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
            btn.Text = "  [ ON ] " .. name
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.Text = "  [ OFF ] " .. name
        end
        callback(active)
    end)
end

